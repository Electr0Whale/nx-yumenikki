+		crt.journal_size = kJournalSize;
+		crt.available_size = 0x4000;
+		crt.owner_id = kTitleId;
+		crt.flags = 0;
+		crt.save_data_space_id = FsSaveDataSpaceId_User;
+
+		FsSaveDataMetaInfo meta = {};
