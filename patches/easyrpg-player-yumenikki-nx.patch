+
+	void EnsureDirectory(const char* path) {
+		if (mkdir(path, 0777) == -1 && errno != EEXIST) {
+			Output::Warning("Could not create directory {}: {}", path, strerror(errno));
+		}
+	}
+
+	void EnsureSdmcFallbackDirectories() {
+		if (fsdevGetDeviceFileSystem("sdmc") == nullptr) {
+			if (R_FAILED(fsdevMountSdmc())) {
+				Output::Warning("Could not mount sdmc for fallback saves/config.");
+				return;
+			}
+		}
+		EnsureDirectory("sdmc:/switch");
+		EnsureDirectory(kSdmcAppRoot);
+		EnsureDirectory(kSdmcSaveRoot);
+	}
+
+	bool AcquireActiveUser(AccountUid& out_uid) {
+		out_uid = {};
+
+		Result rc = accountInitialize(AccountServiceType_Application);
+		if (R_FAILED(rc)) {
+			rc = accountInitialize(AccountServiceType_System);
+		}
+		if (R_FAILED(rc)) {
+			rc = accountInitialize(AccountServiceType_Administrator);
+		}
+
+		if (R_SUCCEEDED(rc)) {
+			// 1. Standard HOS StartupUserAccount=Required flow: preselected user before launch
+			if (R_FAILED(accountGetPreselectedUser(&out_uid)) || !accountUidIsValid(&out_uid)) {
+				// 2. If launched without a preselected user (e.g. Title Override or emulator),
+				//    try showing the official HOS Profile Selector applet.
+				PselUiSettings ui;
+				if (R_SUCCEEDED(pselUiCreate(&ui, PselUiMode_UserSelector))) {
+					pselUiShow(&ui, &out_uid);
+				}
+			}
+
+			// 3. Fallback to last opened user or first registered console account
+			if (!accountUidIsValid(&out_uid)) {
+				accountGetLastOpenedUser(&out_uid);
+			}
+			if (!accountUidIsValid(&out_uid)) {
+				AccountUid uids[ACC_USER_LIST_SIZE] = {};
+				s32 actual_total = 0;
+				if (R_SUCCEEDED(accountListAllUsers(uids, ACC_USER_LIST_SIZE, &actual_total)) && actual_total > 0) {
+					out_uid = uids[0];
+				}
+			}
+
+			accountExit();
+		} else {
+			// Even if account service init failed, try the Profile Selector applet directly
+			PselUiSettings ui;
+			if (R_SUCCEEDED(pselUiCreate(&ui, PselUiMode_UserSelector))) {
+				pselUiShow(&ui, &out_uid);
+			}
+		}
+
+		return accountUidIsValid(&out_uid);
+	}
+
+	Result TryMountSaveDataForUser(AccountUid uid) {
+		Result rc = fsdevMountSaveData("save", FS_SAVEDATA_CURRENT_APPLICATIONID, uid);
+		if (R_FAILED(rc)) {
+			rc = fsdevMountSaveData("save", kTitleId, uid);
+		}
+		return rc;
+	}
