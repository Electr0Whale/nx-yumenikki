+// Headers
+#include "scene_keyguide.h"
+#include "bitmap.h"
+#include "cache.h"
+#include "game_system.h"
+#include "input.h"
+#include "main_data.h"
+#include "player.h"
+#include "scene_settings.h"
+#include "transition.h"
+
+Scene_KeyGuide::Scene_KeyGuide() {
+	type = Scene::KeyGuide;
+}
+
+void Scene_KeyGuide::Start() {
+	FileRequestAsync* request = AsyncHandler::RequestFile("Picture", "SwitchKeyGuide");
+	request->SetGraphicFile(true);
+	request_id = request->Bind(&Scene_KeyGuide::OnGraphicReady, this);
+	request->Start();
+}
+
+void Scene_KeyGuide::OnGraphicReady(FileRequestResult* result) {
+	if (!result || !result->success) {
+		Scene::Pop();
+		Player::SetupNewGame();
+		return;
+	}
+
+	background = std::make_unique<Sprite>();
+	BitmapRef bitmapRef = Cache::Picture(result->file, false);
+	background->SetBitmap(bitmapRef);
+
+	if (bitmapRef->GetWidth() < Player::screen_width) {
+		background->SetX(Player::menu_offset_x);
+	}
+	if (bitmapRef->GetHeight() < Player::screen_height) {
+		background->SetY(Player::menu_offset_y);
+	}
+}
+
+void Scene_KeyGuide::DrawBackground(Bitmap& dst) {
+	dst.Clear();
+}
+
+void Scene_KeyGuide::vUpdate() {
+	if (exiting || Scene::instance.get() != this) {
+		return;
+	}
+
+	// Wait 15 frames (~0.25s) to avoid consuming the button press from Title screen
+	if (wait_frames < 15) {
+		++wait_frames;
+		return;
+	}
+
+	if (Input::IsTriggered(Input::DECISION) ||
+		Input::IsTriggered(Input::CANCEL) ||
+		Input::IsTriggered(Input::SHIFT) ||
+		Input::IsTriggered(Input::UP) ||
+		Input::IsTriggered(Input::DOWN) ||
+		Input::IsTriggered(Input::LEFT) ||
+		Input::IsTriggered(Input::RIGHT)) {
+
+		exiting = true;
+		Main_Data::game_system->SePlay(Main_Data::game_system->GetSystemSE(Main_Data::game_system->SFX_Decision));
+		Scene::Pop();
+		Player::SetupNewGame();
+	}
+}
+
+void Scene_KeyGuide::TransitionIn(SceneType /* prev_scene */) {
+	Transition::instance().InitShow(Transition::TransitionFadeIn, this, 30);
+}
+
+void Scene_KeyGuide::TransitionOut(SceneType /* next_scene */) {
+	Transition::instance().InitErase(Transition::TransitionFadeOut, this, 30);
+}
