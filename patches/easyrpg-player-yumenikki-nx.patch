+ * along with EasyRPG Player. If not, see <http://www.gnu.org/licenses/>.
+ */
+
+#ifndef EP_PLATFORM_SWITCH_INPUT_MAPPING_H
+#define EP_PLATFORM_SWITCH_INPUT_MAPPING_H
+
+#include "keys.h"
+
+#include <bitset>
+#include <cstddef>
+
+namespace SwitchInput {
+	struct PadState {
+		bool up = false;
+		bool down = false;
+		bool left = false;
+		bool right = false;
+		bool a = false;
+		bool b = false;
+		bool x = false;
+		bool y = false;
+		bool l = false;
+		bool r = false;
+		bool zl = false;
+		bool zr = false;
+		bool plus = false;
+		bool minus = false;
+	};
+
+	struct ModifierState {
+		// Latches face buttons that were active while L was held so releasing L
+		// before releasing A/B does not false-trigger a normal button press.
+		bool suppress_normal_a = false;
+		bool suppress_normal_b = false;
+
+		// Latches face buttons that were already held before L was pressed so
+		// pressing L while confirming (A held) or cancelling (B held) does not
+		// accidentally fire a number-key effect chord.
+		bool suppress_chord_a = false;
+		bool suppress_chord_b = false;
+	};
+
+	/**
+	 * Applies the Yume Nikki Switch control layout to the raw key state.
+	 *
+	 * - A: Decision / Confirm (L+A = N1, Effect action 1)
+	 * - B: Cancel (L+B = N3, Effect action 2)
+	 * - X: N9 (Pinch cheek / wake up)
+	 * - Y: N5 (Drop effect)
+	 * - R: Run (SHIFT)
+	 * - Plus (+): In-game Menu (CANCEL)
+	 * - Minus (-): EasyRPG Settings Menu (SETTINGS_MENU)
+	 * - ZR: Fast-forward (FAST_FORWARD_A)
+	 *
+	 * This function deliberately has no libnx dependency so it can be tested
+	 * on the host.
+	 */
+	inline void ApplyPad(const PadState& pad, std::bitset<Input::Keys::KEYS_COUNT>& keys, ModifierState& state) {
+		auto update_latch = [](bool l_held, bool btn_held, bool& suppress_normal, bool& suppress_chord) {
+			if (!btn_held) {
+				suppress_normal = false;
+				suppress_chord = false;
+			} else if (l_held) {
+				if (!suppress_chord) {
+					suppress_normal = true;
+				}
+			} else {
+				if (!suppress_normal) {
+					suppress_chord = true;
+				}
+			}
+		};
+
+		update_latch(pad.l, pad.a, state.suppress_normal_a, state.suppress_chord_a);
+		update_latch(pad.l, pad.b, state.suppress_normal_b, state.suppress_chord_b);
+
+		// Clear the number keys every frame.
+		keys[Input::Keys::N1] = false;
+		keys[Input::Keys::N3] = false;
+		keys[Input::Keys::N5] = false;
+		keys[Input::Keys::N9] = false;
+
+		// Movement remains available at all times.
+		keys[Input::Keys::JOY_DPAD_UP] = pad.up;
+		keys[Input::Keys::JOY_DPAD_DOWN] = pad.down;
+		keys[Input::Keys::JOY_DPAD_LEFT] = pad.left;
+		keys[Input::Keys::JOY_DPAD_RIGHT] = pad.right;
+
+		// Face buttons: A = Decision (互动), B = Cancel / Menu (菜单/取消)
+		keys[Input::Keys::JOY_A] = pad.a;
+		keys[Input::Keys::JOY_B] = pad.b;
+		keys[Input::Keys::JOY_X] = false;
+		keys[Input::Keys::JOY_Y] = false;
+
+		// Number-key actions:
+		// X = N1 (使用效果/坐下)
+		// Y = N3 (退出效果)
+		// L = N5 (丢下效果)
+		// R = N9 (醒来)
+		keys[Input::Keys::N1] = pad.x;
+		keys[Input::Keys::N3] = pad.y;
+		keys[Input::Keys::N5] = pad.l;
+		keys[Input::Keys::N9] = pad.r;
+
+		// Shoulder, stick, and menu buttons.
+		keys[Input::Keys::JOY_SHOULDER_LEFT] = false;
+		keys[Input::Keys::JOY_SHOULDER_RIGHT] = false;
+		keys[Input::Keys::JOY_LSTICK] = false;
+		keys[Input::Keys::JOY_RSTICK] = false;
+		keys[Input::Keys::JOY_BACK] = pad.minus; // EasyRPG 设置菜单
+		keys[Input::Keys::JOY_START] = pad.plus; // 加号加速
+		keys[Input::Keys::JOY_LTRIGGER_FULL] = false; // ZL 专属用于显隐边框
+		keys[Input::Keys::JOY_RTRIGGER_FULL] = pad.zr; // ZR 加速
+	}
+
+	inline void ApplyPad(const PadState& pad, std::bitset<Input::Keys::KEYS_COUNT>& keys) {
+		ModifierState stateless;
+		ApplyPad(pad, keys, stateless);
+	}
+}
+
+#endif
