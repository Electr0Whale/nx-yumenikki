+
+	bool MountNandAccountSaveData() {
+		AccountUid uid = {};
+		if (!AcquireActiveUser(uid)) {
+			Output::Warning("No valid HOS AccountUid available for NAND save data.");
+			return false;
+		}
+
+		Result rc = TryMountSaveDataForUser(uid);
+		if (R_FAILED(rc)) {
+			// If HOS did not auto-create the save container yet (e.g., emulator or NRO override),
+			// create the Account SaveData container on NAND and retry mounting.
+			CreateAccountSaveDataForUser(uid);
+			rc = TryMountSaveDataForUser(uid);
+		}
+
+		if (R_FAILED(rc)) {
+			Output::Warning("Could not mount NAND save:/ (rc=0x{:X}); falling back to SD card.", rc);
+			return false;
+		}
+
+		return true;
+	}
