diff -urN vendor/easyrpg-player-0.8.1.1/src/platform/switch/input_mapping.h work/src/easyrpg-player-0.8.1.1/src/platform/switch/input_mapping.h
--- vendor/easyrpg-player-0.8.1.1/src/platform/switch/input_mapping.h	1970-01-01 08:00:00.000000000 +0800
+++ work/src/easyrpg-player-0.8.1.1/src/platform/switch/input_mapping.h	2026-11-03 01:12:56.285255800 +0800
@@ -0,0 +1,132 @@
+/*
